---
import Card from '../Card.astro'
import { Button } from '../ui/button'
import { BarChart3, Calendar, FolderOpen, Mail, Route } from 'lucide-react'
import { LINKS } from '../../lib/constants'
---

<Card colSpan="md:col-span-2 lg:col-span-4" rowSpan="md:row-span-1 lg:row-span-1">
  <section id="start" class="flex h-full w-full flex-col gap-6">

    <div class="flex flex-col items-start gap-6 md:flex-row">
      <img
        src="/me.png"
        alt="Sergej Görzen"
        class="h-40 w-auto flex-shrink-0 self-center md:h-48 md:self-start"
      />

      <div class="flex flex-1 flex-col gap-6">
        <div class="space-y-3">
          <p class="m-0 text-sm font-semibold uppercase tracking-wide text-muted-foreground">
            XR Learning · Training · Learning Analytics · Evaluation
          </p>
          <h1 class="m-0 max-w-4xl text-3xl font-bold leading-tight md:text-4xl">
            XR-Lern- und Trainingsszenarien, die didaktisch funktionieren und messbare Daten liefern.
          </h1>
          <p class="m-0 max-w-4xl text-base text-muted-foreground md:text-lg">
            Ich begleite Unternehmen, Hochschulen und Forschungsteams von der Anforderungsanalyse über XR-Umsetzung und xAPI-/Learning-Analytics-Integration bis zur Evaluation und zum belastbaren Report.
            Für ganzheitliche Lösungen hole ich bei Bedarf spezialisierte Freelancer aus meinem Netzwerk dazu, damit Konzeption, Umsetzung, Design, Datenanalyse und Rollout sauber zusammenspielen.
          </p>
          <p class="m-0 max-w-4xl text-sm text-muted-foreground">
            <span class="font-semibold text-foreground">Projektanträge & Verbundvorhaben:</span>
            {' '}Auch als technischer Umsetzungspartner – von Machbarkeitsprüfung und Arbeitspaketen bis Prototyping, Datenintegration und Evaluation.
          </p>
        </div>

        <div class="flex flex-wrap gap-3">
          <a href={LINKS.calendly} target="_blank" rel="noreferrer">
            <Button>
              <Calendar />
              <span class="ml-2">Erstgespräch buchen</span>
            </Button>
          </a>
          <a href="#xr-projektcheck">
            <Button variant="outline">
              <BarChart3 />
              <span class="ml-2">Projektcheck starten</span>
            </Button>
          </a>
          <Button
            type="button"
            variant="secondary"
            data-open-dialog="contact-form"
            aria-haspopup="dialog"
            aria-controls="contact-form"
          >
            <Mail />
            <span class="ml-2">Projektanfrage senden</span>
          </Button>
          <a href="#xr-pipeline">
            <Button variant="ghost">
              <Route />
              <span class="ml-2">Pipeline ansehen</span>
            </Button>
          </a>
          <a href="/projects">
            <Button variant="ghost">
              <FolderOpen />
              <span class="ml-2">Belege ansehen</span>
            </Button>
          </a>
        </div>
      </div>
    </div>

    <div class="grid gap-3 text-sm md:grid-cols-3">
      <div class="border-t pt-3">
        <p class="m-0 font-semibold">Pipeline statt Einzel-App</p>
        <p class="m-0 text-muted-foreground">Von Lernziel und Szenariodesign bis XR-Umsetzung, Datenerhebung, Auswertung und Report.</p>
      </div>
      <div class="border-t pt-3">
        <p class="m-0 font-semibold">Forschung + Delivery</p>
        <p class="m-0 text-muted-foreground">Dr.-Ing. in Informatik, 10+ Jahre Softwareentwicklung, Tech Lead und XR-/Learning-Analytics-Forschung.</p>
      </div>
      <div class="border-t pt-3">
        <p class="m-0 font-semibold">xAPI, OmiLAXR, Evaluation</p>
        <p class="m-0 text-muted-foreground">Promotion zur Reduktion von Integrationskomplexität für Learning Analytics in XR.</p>
      </div>
    </div>

  </section>
</Card>
