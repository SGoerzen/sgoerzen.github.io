---
import Card from '../Card.astro'
import { Card as PackageCard } from '../ui/card'
import { SERVICES } from '../../lib/constants'
---

<Card colSpan="md:col-span-2 lg:col-span-4" rowSpan="md:row-span-1 lg:row-span-1" title="Pakete & Preisrahmen" body="Planbare Einstiegspunkte für XR-Lern- und Trainingsvorhaben.">
  <section id="leistungen" class="mt-5 space-y-5">
    <p class="m-0 max-w-4xl text-sm text-muted-foreground">
      Die Preise sind Richtwerte für die Projektplanung. Ein verbindlicher Festpreis entsteht nach dem Scoping; externe Kosten wie Hardware, 3D-Asset-Produktion, Reisen, LRS-/Cloud-Betrieb oder LMS-Integrationen werden separat betrachtet.
      Aufgrund der Steuerbefreiung für Kleinunternehmer gemäß § 19 UStG wird keine Umsatzsteuer berechnet.
    </p>
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        SERVICES.map((service) => (
          <PackageCard className="flex h-full flex-col p-5 shadow-none">
            <div class="space-y-2">
              <h3 class="m-0 text-lg font-semibold leading-snug">{service.title}</h3>
              {service.price && (
                <p class="m-0 inline-block rounded-full bg-primary/10 px-2.5 py-1 text-sm font-semibold text-primary">
                  {service.price}
                </p>
              )}
            </div>
            <p class="mt-2 text-sm text-muted-foreground">{service.description}</p>
            <ul class="mt-4 list-disc space-y-1.5 border-t pt-4 pl-5 text-sm text-muted-foreground">
              {service.bullets.map((bullet) => (
                <li>{bullet}</li>
              ))}
            </ul>
          </PackageCard>
        ))
      }
    </div>
  </section>
</Card>
