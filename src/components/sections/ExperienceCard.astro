---
import { ArrowLeft, ArrowRight, Pause, Play } from 'lucide-react'
import Card from '../Card.astro'
import { Button } from '../ui/button'
import { XR_PROJECTS } from '../../lib/constants'
import OmiLAXRProjectCard from '../OmiLAXRProjectCard.astro'
import AcademicSupervisionCard from './AcademicSupervisionCard.astro'

const carouselItemCount = XR_PROJECTS.length + 1
---

<Card
  colSpan="md:col-span-2 lg:col-span-4"
  rowSpan="md:row-span-2 lg:row-span-2"
  title="XR-Projekte"
  body="Alle Referenzen auf einen Blick – von VR-Lernwelten über AR-Training bis zu browserbasierter Event-Tech."
>
  <section id="projekte" class="mt-5 scroll-mt-24">
    <xr-project-carousel class="block" aria-label="XR-Projekte">
      <div class="mb-4 flex items-center justify-between gap-4">
        <p class="m-0 text-sm text-muted-foreground" aria-live="polite">
          <span data-carousel-current>1</span>
          <span aria-hidden="true"> / </span>
          <span class="sr-only">von</span>
          <span>{carouselItemCount}</span>
        </p>

        <div class="flex gap-2">
          <Button
            type="button"
            variant="outline"
            size="icon"
            data-carousel-previous
            aria-label="Vorheriges Projekt"
          >
            <ArrowLeft aria-hidden="true" />
          </Button>
          <Button
            type="button"
            variant="outline"
            size="icon"
            data-carousel-toggle
            aria-label="Automatisches Abspielen pausieren"
          >
            <Pause data-carousel-pause-icon aria-hidden="true" />
            <Play data-carousel-play-icon className="hidden" aria-hidden="true" />
          </Button>
          <Button
            type="button"
            variant="outline"
            size="icon"
            data-carousel-next
            aria-label="Nächstes Projekt"
          >
            <ArrowRight aria-hidden="true" />
          </Button>
        </div>
      </div>

      <div
        data-carousel-track
        class="carousel-track -mx-1 -mt-2 flex snap-x snap-mandatory gap-4 overflow-x-auto px-1 pb-2 pt-2 scroll-smooth"
        tabindex="0"
        aria-label="XR-Projektkarten"
      >
        {
          XR_PROJECTS.map((project, index) => (
            <div
              data-carousel-slide
              class="flex w-[calc(100%-0.25rem)] shrink-0 snap-start sm:w-[calc(50%-0.5rem)]"
              role="group"
              aria-label={`${index + 1} von ${carouselItemCount}: ${project.title}`}
            >
              <OmiLAXRProjectCard project={project} compact />
            </div>
          ))
        }
        <div
          data-carousel-slide
          class="flex w-[calc(100%-0.25rem)] shrink-0 snap-start sm:w-[calc(50%-0.5rem)]"
          role="group"
          aria-label={`${carouselItemCount} von ${carouselItemCount}: Akademische Betreuung`}
        >
          <AcademicSupervisionCard />
        </div>
      </div>

      <div class="mt-4 flex flex-wrap items-center gap-3">
        <div class="flex gap-1.5" aria-label="Projekt auswählen">
          {
            XR_PROJECTS.map((project, index) => (
              <button
                type="button"
                data-carousel-dot
                data-index={index}
                class="h-2.5 w-2.5 rounded-full bg-muted-foreground/30 transition-all hover:bg-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2"
                aria-label={`${project.title} anzeigen`}
                aria-current={index === 0 ? 'true' : undefined}
              />
            ))
          }
          <button
            type="button"
            data-carousel-dot
            data-index={XR_PROJECTS.length}
            class="h-2.5 w-2.5 rounded-full bg-muted-foreground/30 transition-all hover:bg-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2"
            aria-label="Akademische Betreuung anzeigen"
          />
        </div>
      </div>

    </xr-project-carousel>
  </section>
</Card>

<style>
  .carousel-track {
    scrollbar-width: none;
  }

  .carousel-track::-webkit-scrollbar {
    display: none;
  }

  [data-carousel-dot][aria-current='true'] {
    width: 1.75rem;
    background: hsl(var(--primary));
  }
</style>

<script>
  class XRProjectCarousel extends HTMLElement {
    private track: HTMLElement | null = null
    private slides: HTMLElement[] = []
    private dots: HTMLButtonElement[] = []
    private current = 0
    private autoplay: number | undefined
    private observer: IntersectionObserver | undefined
    private resumeTimeout: number | undefined
    private userPaused = false

    connectedCallback() {
      this.track = this.querySelector('[data-carousel-track]')
      this.slides = Array.from(this.querySelectorAll('[data-carousel-slide]'))
      this.dots = Array.from(this.querySelectorAll('[data-carousel-dot]'))

      if (!this.track || this.slides.length === 0) return

      this.querySelector('[data-carousel-previous]')?.addEventListener('click', () => {
        this.goTo(this.current - 1)
        this.pauseTemporarily()
      })
      this.querySelector('[data-carousel-next]')?.addEventListener('click', () => {
        this.goTo(this.current + 1)
        this.pauseTemporarily()
      })
      this.dots.forEach((dot, index) => {
        dot.addEventListener('click', () => {
          this.goTo(index)
          this.pauseTemporarily()
        })
      })

      this.userPaused = window.matchMedia('(prefers-reduced-motion: reduce)').matches
      this.querySelector('[data-carousel-toggle]')?.addEventListener('click', this.toggleAutoplay)
      this.updateAutoplayButton()

      this.track.addEventListener('pointerdown', this.stopAutoplay)
      this.track.addEventListener('pointerup', this.pauseTemporarily)

      this.observer = new IntersectionObserver(
        () => this.syncCurrentSlide(),
        { root: this.track, threshold: [0.55, 0.75, 1] },
      )
      this.slides.forEach((slide) => this.observer?.observe(slide))
      this.startAutoplay()
    }

    disconnectedCallback() {
      this.stopAutoplay()
      window.clearTimeout(this.resumeTimeout)
      this.observer?.disconnect()
    }

    private goTo(index: number) {
      const normalizedIndex = (index + this.slides.length) % this.slides.length
      this.current = normalizedIndex
      this.slides[normalizedIndex]?.scrollIntoView({
        behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
        block: 'nearest',
        inline: 'start',
      })
      this.updateStatus()
    }

    private updateStatus() {
      const currentLabel = this.querySelector('[data-carousel-current]')
      if (currentLabel) currentLabel.textContent = String(this.current + 1)
      this.dots.forEach((dot, index) => {
        if (index === this.current) dot.setAttribute('aria-current', 'true')
        else dot.removeAttribute('aria-current')
      })
    }

    private syncCurrentSlide() {
      if (!this.track) return

      const trackBounds = this.track.getBoundingClientRect()
      const isAtEnd = Math.abs(this.track.scrollWidth - this.track.clientWidth - this.track.scrollLeft) < 2

      if (isAtEnd) {
        this.current = this.slides.length - 1
      } else {
        const visibility = this.slides.map((slide, index) => {
          const bounds = slide.getBoundingClientRect()
          const visibleWidth = Math.max(
            0,
            Math.min(bounds.right, trackBounds.right) - Math.max(bounds.left, trackBounds.left),
          )
          return { index, visibleWidth }
        })
        visibility.sort((a, b) => b.visibleWidth - a.visibleWidth || a.index - b.index)
        this.current = visibility[0]?.index ?? 0
      }

      this.updateStatus()
    }

    private startAutoplay = () => {
      if (this.userPaused) return
      this.stopAutoplay()
      this.autoplay = window.setInterval(() => this.goTo(this.current + 1), 5500)
    }

    private stopAutoplay = () => {
      window.clearInterval(this.autoplay)
    }

    private toggleAutoplay = () => {
      this.userPaused = !this.userPaused
      window.clearTimeout(this.resumeTimeout)
      if (this.userPaused) this.stopAutoplay()
      else this.startAutoplay()
      this.updateAutoplayButton()
    }

    private updateAutoplayButton() {
      const button = this.querySelector<HTMLButtonElement>('[data-carousel-toggle]')
      const pauseIcon = this.querySelector<HTMLElement>('[data-carousel-pause-icon]')
      const playIcon = this.querySelector<HTMLElement>('[data-carousel-play-icon]')
      button?.setAttribute(
        'aria-label',
        this.userPaused ? 'Automatisches Abspielen fortsetzen' : 'Automatisches Abspielen pausieren',
      )
      pauseIcon?.classList.toggle('hidden', this.userPaused)
      playIcon?.classList.toggle('hidden', !this.userPaused)
    }

    private pauseTemporarily = () => {
      this.stopAutoplay()
      window.clearTimeout(this.resumeTimeout)
      this.resumeTimeout = window.setTimeout(this.startAutoplay, 9000)
    }
  }

  if (!customElements.get('xr-project-carousel')) {
    customElements.define('xr-project-carousel', XRProjectCarousel)
  }
</script>
