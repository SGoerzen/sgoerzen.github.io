---
import Card from '../Card.astro'
import { Button } from '../ui/button'
import { XR_PROJECTS } from '../../lib/constants'
import OmiLAXRProjectCard from '../OmiLAXRProjectCard.astro'
---

<Card colSpan="md:col-span-2 lg:col-span-4" rowSpan="md:row-span-2 lg:row-span-2" title="Ausgewählte XR-Projekte" body="Interaktive XR-Systeme für Lernen, Training und räumliche Orientierung.">
  <section id="cases" class="mt-5">
    <div class="grid gap-4 md:grid-cols-2 [&>*:last-child:nth-child(odd)]:md:col-span-2">
      {
        XR_PROJECTS.map((project) => (
          <OmiLAXRProjectCard project={project} compact />
        ))
      }
    </div>
    <a href="/projects" class="inline-block pt-3">
      <Button variant="link" className="pl-0">Alle XR-Projekte</Button>
    </a>
  </section>
</Card>
