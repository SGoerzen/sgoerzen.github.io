---
import { ArrowRight, Blocks, Code2 } from 'lucide-react'
import Card from '../Card.astro'
import { Button } from '../ui/button'

const workshops = [
  {
    label: 'Grundlagen',
    title: 'OmiLAXR Grundlagen-Workshop',
    price: 'ab 2.900 €',
    description:
      'Die Grundlagen von Learning Analytics in XR kennenlernen und OmiLAXR an einem vorbereiteten Unity-Beispiel praktisch ausprobieren.',
    meta: ['1 Tag', 'bis 6 Personen', 'remote oder vor Ort'],
    bullets: [
      'Grundlagen zu Messfragen und relevanten XR-Events',
      'XR-Events mit OmiLAXR erfassen und behandeln',
      'Erste xAPI-Statements erzeugen und nachvollziehen',
    ],
    Icon: Blocks,
  },
  {
    label: 'Grundlagen am eigenen Projekt',
    title: 'OmiLAXR Projekt-Workshop',
    price: 'ab 4.900 €',
    description:
      'Die gleichen Grundlagen direkt auf ein eigenes Unity-XR-Projekt anwenden und gemeinsam einen ersten Tracking-Pfad aufsetzen.',
    meta: ['1 Tag', 'bis 6 Personen', 'inkl. Vorabcheck'],
    bullets: [
      'Grundlagen zu Messfragen anhand des eigenen Szenarios',
      'Geeignete XR-Events auswählen und mit OmiLAXR behandeln',
      'Erste xAPI-Statements im eigenen Projekt erzeugen',
    ],
    Icon: Code2,
  },
]

---

<Card
  colSpan="md:col-span-2 lg:col-span-4"
  rowSpan="md:row-span-1 lg:row-span-1"
  title="OmiLAXR Grundlagen-Workshops"
  body="Grundlagen von Learning Analytics in Unity-XR-Anwendungen kennenlernen und praktisch anwenden."
>
  <section id="omilaxr-workshops" class="mt-5">
    <div class="grid gap-5 md:grid-cols-2">
      {
        workshops.map(({ label, title, price, description, meta, bullets, Icon }) => (
          <article class="flex h-full flex-col rounded-xl border bg-muted/20 p-5">
            <div class="flex items-start gap-3">
              <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-primary/10 text-primary">
                <Icon size={20} strokeWidth={1.8} aria-hidden="true" />
              </span>
              <div>
                <p class="m-0 text-[0.68rem] font-semibold uppercase tracking-[0.14em] text-primary">
                  {label}
                </p>
                <h3 class="m-0 mt-0.5 text-lg font-semibold">{title}</h3>
                <p class="m-0 mt-1 text-sm font-semibold text-primary">{price}</p>
              </div>
            </div>

            <p class="mb-0 mt-4 text-sm leading-relaxed text-muted-foreground">{description}</p>

            <div class="mt-3 flex flex-wrap gap-2">
              {meta.map((item) => (
                <span class="rounded-full border bg-background px-2.5 py-1 text-[0.7rem] font-medium text-muted-foreground">
                  {item}
                </span>
              ))}
            </div>

            <ul class="mb-0 mt-4 list-disc space-y-1.5 border-t pt-4 pl-5 text-sm text-muted-foreground">
              {bullets.map((bullet) => <li>{bullet}</li>)}
            </ul>
          </article>
        ))
      }
    </div>

    <div class="mt-5 flex flex-col gap-4 border-t pt-5 sm:flex-row sm:items-center sm:justify-between">
      <p class="m-0 max-w-3xl text-sm text-muted-foreground">
        Inklusive Vorbereitungsgespräch, Arbeitsmaterialien und 60-minütigem Follow-up. Reiseaufwand wird separat kalkuliert.
      </p>
      <Button
        type="button"
        className="shrink-0"
        data-open-dialog="contact-form"
        aria-haspopup="dialog"
        aria-controls="contact-form"
      >
        Workshop anfragen
        <ArrowRight className="ml-2" size={17} aria-hidden="true" />
      </Button>
    </div>
  </section>
</Card>
