---
import {
  BarChart3,
  Boxes,
  Cable,
  DraftingCompass,
  Lightbulb,
  MessageCircle,
  RefreshCw,
  ScanSearch,
  Sparkles,
} from "lucide-react";
import Card from "../Card.astro";

const paths = [
  {
    eyebrow: "Startpunkt A",
    title: "Neue XR-Idee",
    description:
      "Scoping oder vorhandene Vorarbeiten schaffen die Grundlage für einen Pilot.",
    Icon: Lightbulb,
    gridClass: "sm:grid-cols-3",
    steps: [
      {
        title: "XR Scoping Sprint",
        price: "ab 4.900 €",
        result: "Entscheidungsgrundlage & Rahmen",
        Icon: ScanSearch,
      },
      {
        title: "Didaktik & XR-Konzept",
        price: "ab 5.900 €",
        result: "Szenario oder Blueprint",
        Icon: DraftingCompass,
      },
      {
        title: "Neuer XR-Pilot / MVP",
        price: "typ. 20.000-69.000 €",
        result: "Einsatzfähiger Pilot",
        Icon: Boxes,
      },
    ],
  },
  {
    eyebrow: "Startpunkt B",
    title: "Bestehende XR-App",
    description: "Ein Audit klärt offene Fragen; belastbare Spezifikationen werden übernommen.",
    Icon: Cable,
    gridClass: "sm:grid-cols-2",
    steps: [
      {
        title: "Analytics Audit",
        price: "ab 6.900 €",
        result: "Mess- & Integrationsplan",
        Icon: ScanSearch,
      },
      {
        title: "Analytics-Integration",
        price: "Starter ab 7.900 €",
        result: "Validierter Datenfluss",
        Icon: Cable,
      },
    ],
  },
];
---

<Card
  colSpan="md:col-span-2 lg:col-span-4"
  rowSpan="md:row-span-1 lg:row-span-1"
  title="So greifen die Angebote ineinander"
  body="Ein unverbindliches Erstgespräch, zwei Einstiegspunkte und ein modularer Weg zur belastbaren XR-Entscheidung."
>
  <section
    id="prozess"
    class="mt-6 scroll-mt-28"
    aria-label="Angebots-Pipeline"
  >
    <article
      class="relative mx-auto max-w-xl overflow-hidden rounded-xl border border-primary/35 bg-gradient-to-br from-primary/10 via-background to-background p-5 shadow-sm"
    >
      <div
        aria-hidden="true"
        class="absolute right-0 top-0 h-28 w-28 rounded-full bg-primary/10 blur-3xl"
      >
      </div>
      <div class="relative flex flex-col gap-4 sm:flex-row sm:items-center">
        <span
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-primary text-primary-foreground shadow-sm"
        >
          <MessageCircle aria-hidden="true" size={23} strokeWidth={1.8} />
        </span>
        <div class="min-w-0 flex-1">
          <div class="flex flex-wrap items-center gap-2">
            <p
              class="m-0 text-[0.68rem] font-semibold uppercase tracking-[0.14em] text-primary"
            >
              Gemeinsamer Einstieg
            </p>
            <span
              class="rounded-full border border-primary/20 bg-primary/10 px-2 py-0.5 text-[0.65rem] font-semibold text-primary"
            >
              unverbindlich
            </span>
          </div>
          <h3 class="m-0 mt-1 text-lg font-semibold">
            Unverbindliches Erstgespräch
          </h3>
          <p class="m-0 mt-1 text-sm text-muted-foreground">
            Ziel, Ausgangslage und den passenden nächsten Schritt gemeinsam
            klären.
          </p>
        </div>
      </div>
    </article>

    <div class="relative hidden h-16 lg:block" aria-hidden="true">
      <svg
        class="h-full w-full text-primary/55"
        viewBox="0 0 1000 64"
        preserveAspectRatio="none"
      >
        <path
          d="M500 0 V12 Q500 32 480 32 H270 Q250 32 250 52 V64"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-dasharray="5 5"></path>
        <path
          d="M500 0 V12 Q500 32 520 32 H730 Q750 32 750 52 V64"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-dasharray="5 5"></path>
        <circle cx="500" cy="32" r="4" fill="currentColor"></circle>
      </svg>
    </div>
    <div
      class="mx-auto flex h-12 w-px items-center justify-center bg-gradient-to-b from-primary/60 to-transparent lg:hidden"
      aria-hidden="true"
    >
      <span
        class="whitespace-nowrap rounded-full border bg-background px-2 py-1 text-[0.6rem] font-semibold uppercase tracking-[0.12em] text-muted-foreground"
        >Startpunkt wählen</span
      >
    </div>

    <div class="grid gap-5 lg:grid-cols-2">
      {
        paths.map(({ eyebrow, title, description, Icon, gridClass, steps }) => (
          <article class="relative overflow-hidden rounded-xl border bg-muted/20 p-4 sm:p-5">
            <div class="mb-5 flex items-start gap-3">
              <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-primary/10 text-primary ring-1 ring-primary/15">
                <Icon aria-hidden="true" size={20} strokeWidth={1.8} />
              </span>
              <div>
                <p class="m-0 text-[0.68rem] font-semibold uppercase tracking-[0.14em] text-primary">
                  {eyebrow}
                </p>
                <h3 class="m-0 mt-0.5 text-lg font-semibold">{title}</h3>
                <p class="m-0 mt-1 text-sm text-muted-foreground">
                  {description}
                </p>
              </div>
            </div>

            <ol class:list={["grid gap-7 sm:gap-4", gridClass]}>
              {steps.map(({ title, price, result, Icon: StepIcon }, index) => (
                <li class="relative min-w-0">
                  <div class="group flex h-full min-h-40 flex-col rounded-lg border bg-background p-4 transition duration-300 hover:-translate-y-0.5 hover:border-primary/40 hover:shadow-sm">
                    <div class="flex items-center justify-between gap-3">
                      <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-primary/10 text-primary">
                        <StepIcon
                          aria-hidden="true"
                          size={17}
                          strokeWidth={1.8}
                        />
                      </span>
                      <span class="text-[0.65rem] font-semibold uppercase tracking-[0.12em] text-muted-foreground">
                        {String(index + 1).padStart(2, "0")}
                      </span>
                    </div>
                    <h4 class="mb-0 mt-3 text-sm font-semibold leading-snug">
                      {title}
                    </h4>
                    <p class="mb-0 mt-1 text-xs font-semibold text-primary">
                      {price}
                    </p>
                    <p class="mb-0 mt-auto border-t border-dashed pt-3 text-xs leading-relaxed text-muted-foreground">
                      {result}
                    </p>
                  </div>

                  {index < steps.length - 1 && (
                    <div
                      aria-hidden="true"
                      class="pointer-events-none absolute -bottom-7 left-4 h-7 w-px bg-primary/60 sm:-right-4 sm:bottom-auto sm:left-auto sm:top-8 sm:h-px sm:w-4"
                    >
                    </div>
                  )}
                </li>
              ))}
            </ol>
          </article>
        ))
      }
    </div>

    <div class="relative hidden h-16 lg:block" aria-hidden="true">
      <svg
        class="h-full w-full text-primary/55"
        viewBox="0 0 1000 64"
        preserveAspectRatio="none"
      >
        <path
          d="M250 0 V20 Q250 32 265 32 H480 Q500 32 500 52 V64"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-dasharray="5 5"></path>
        <path
          d="M750 0 V20 Q750 32 735 32 H520 Q500 32 500 52 V64"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-dasharray="5 5"></path>
        <circle cx="500" cy="32" r="4" fill="currentColor"></circle>
      </svg>
    </div>
    <div
      class="mx-auto h-8 w-px bg-gradient-to-b from-transparent to-primary/60 lg:hidden"
      aria-hidden="true"
    >
    </div>

    <article
      class="relative mx-auto max-w-xl overflow-hidden rounded-xl border border-primary/35 bg-gradient-to-br from-primary/10 via-background to-background p-5 shadow-sm"
    >
      <div
        aria-hidden="true"
        class="absolute right-0 top-0 h-28 w-28 rounded-full bg-primary/10 blur-3xl"
      >
      </div>
      <div class="relative flex flex-col gap-4 sm:flex-row sm:items-center">
        <span
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-primary text-primary-foreground shadow-sm"
        >
          <BarChart3 aria-hidden="true" size={23} strokeWidth={1.8} />
        </span>
        <div class="min-w-0 flex-1">
          <div class="flex flex-wrap items-center gap-2">
            <p
              class="m-0 text-[0.68rem] font-semibold uppercase tracking-[0.14em] text-primary"
            >
              Gemeinsamer Folgeschritt
            </p>
            <span
              class="rounded-full border border-primary/20 bg-primary/10 px-2 py-0.5 text-[0.65rem] font-semibold text-primary"
            >
              aus beiden Pfaden
            </span>
          </div>
          <h3 class="m-0 mt-1 text-lg font-semibold">
            Evaluation & Ergebnisbericht
          </h3>
          <p class="m-0 mt-1 text-sm text-muted-foreground">
            Evaluation mit einer definierten Testgruppe planen, begleiten und
            Ergebnisse vorsichtig einordnen.
          </p>
        </div>
        <p class="m-0 shrink-0 text-sm font-semibold text-primary">
          typ. 12.900–29.000 €
        </p>
      </div>
    </article>

    <aside
      class="mx-auto mt-6 flex max-w-3xl flex-col gap-4 rounded-xl border border-primary/25 bg-primary/5 p-5 sm:flex-row sm:items-start"
      aria-labelledby="additional-iterations"
    >
      <span
        class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-primary/10 text-primary"
      >
        <RefreshCw aria-hidden="true" size={20} strokeWidth={1.8} />
      </span>
      <div>
        <h3 id="additional-iterations" class="m-0 text-base font-semibold">
          Flexibel um weitere Features erweiterbar
        </h3>
        <p class="m-0 mt-2 text-sm leading-relaxed text-muted-foreground">
          Nach jedem Meilenstein kann das Projekt gezielt erweitert werden.
          Zusätzliche Features und neue Anforderungen planen wir als separate
          Iteration – mit transparentem Aufwand, Budget und Zeitrahmen vor der
          Umsetzung.
        </p>
      </div>
    </aside>

    <div
      class="mt-6 flex flex-wrap items-center justify-center gap-x-5 gap-y-2 rounded-lg border border-dashed bg-muted/30 px-4 py-3 text-xs text-muted-foreground"
    >
      <span
        class="flex items-center gap-2 font-semibold uppercase tracking-[0.13em] text-foreground"
      >
        <Sparkles aria-hidden="true" size={14} class="text-primary" />
        Iterativ &amp; flexibel
      </span>
      <span>Umsetzung und Abrechnung in klar abgegrenzten Iterationen</span>
      <span>Nach jeder Iteration: fortführen, anpassen oder aussteigen</span>
    </div>

    <p
      class="mx-auto mb-0 mt-3 max-w-4xl text-center text-[0.7rem] leading-relaxed text-muted-foreground"
    >
      Alle Preisangaben sind Richtwerte. Ein verbindlicher Festpreis entsteht
      nach der Prüfung der Ausgangslage; Inhalte werden nicht doppelt berechnet.
      Hardware, 3D-Assets, Reisen, Cloud-Betrieb und individuelle Backend-,
      Dashboard- oder LMS-Erweiterungen werden separat betrachtet.
      Zeitplan und Meilensteine stimmen wir anschließend passend zu Umfang und
      Rahmenbedingungen ab.
    </p>
  </section>
</Card>
