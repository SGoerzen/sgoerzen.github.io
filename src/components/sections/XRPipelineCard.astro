---
import Card from '../Card.astro'

const steps = [
  {
    title: 'Ziele klären',
    text: 'Lernziel, Zielgruppe, Rahmen und Erfolgskriterien festlegen.',
  },
  {
    title: 'Szenario planen',
    text: 'Didaktik, Interaktionen, Technik und Messpunkte zusammenführen.',
  },
  {
    title: 'Umsetzen & integrieren',
    text: 'XR-Anwendung, Datenfluss und vorhandene Systeme verbinden.',
  },
  {
    title: 'Erproben & auswerten',
    text: 'Pilotieren, Daten prüfen und nächste Schritte belastbar ableiten.',
  },
]
---

<Card colSpan="md:col-span-2 lg:col-span-4" rowSpan="md:row-span-1 lg:row-span-1" title="Vom Ziel zum belastbaren Ergebnis" body="Ein klarer Prozess für neue Szenarien und bestehende XR-Anwendungen.">
  <section id="xr-pipeline" class="mt-5">
    <ol class="grid gap-5 md:grid-cols-2 lg:grid-cols-4">
      {
        steps.map((step, index) => (
          <li class="border-t pt-4">
            <span class="flex h-7 w-7 items-center justify-center rounded-full bg-primary text-xs font-semibold text-primary-foreground">
              {index + 1}
            </span>
            <p class="mt-3 font-semibold">{step.title}</p>
            <p class="m-0 text-sm text-muted-foreground">{step.text}</p>
          </li>
        ))
      }
    </ol>
  </section>
</Card>
