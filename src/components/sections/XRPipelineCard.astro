---
import Card from '../Card.astro'

const newScenarioSteps = [
  {
    title: 'Kostenloses Erstgespräch',
    text: 'Fit, Zielgruppe, Budgetrahmen und grobe Machbarkeit klären.',
  },
  {
    title: 'Anforderungsanalyse',
    text: 'Lernziele, Trainingskontext, Nutzergruppen, Plattform und Rahmenbedingungen erfassen.',
  },
  {
    title: 'Didaktisches Konzept',
    text: 'Szenario, Aufgabenlogik, Feedback, Erfolgskriterien und Transfer in die Praxis festlegen.',
  },
  {
    title: 'XR-Umsetzung',
    text: 'Prototyp, Pilot oder produktionsnahes Szenario mit Unity oder Three.js/WebXR realisieren.',
  },
  {
    title: 'Evaluation & Datenintegration',
    text: 'Evaluationskonzept, xAPI-/Telemetry-Events, Monitoring und Datenqualitätscheck aufsetzen.',
  },
  {
    title: 'Auswertung & Report',
    text: 'Daten analysieren, Ergebnisse visualisieren und konkrete Handlungsempfehlungen ableiten.',
  },
]

const existingAppSteps = [
  {
    title: 'Kostenloses Erstgespräch',
    text: 'Zielbild, vorhandene App, Risiken und sinnvollen Einstiegspunkt bestimmen.',
  },
  {
    title: 'App- und Konzept-Audit',
    text: 'Code, Nutzerfluss, Lernziele, technische Architektur und vorhandene Datenquellen prüfen.',
  },
  {
    title: 'Messkonzept',
    text: 'Relevante Events, xAPI-Struktur, Kennzahlen und Auswertungsfragen definieren.',
  },
  {
    title: 'Analytics-Integration',
    text: 'Telemetry, LRS-/Backend-Anbindung, Live-Monitoring und Datenvalidierung integrieren.',
  },
  {
    title: 'Evaluation',
    text: 'Pilotstudie, Trainingsdurchlauf oder Nutzertest methodisch vorbereiten und begleiten.',
  },
  {
    title: 'Report & Roadmap',
    text: 'Ergebnisse auswerten, Verbesserungen priorisieren und nächste Ausbaustufen planen.',
  },
]
---

<Card colSpan="md:col-span-2 lg:col-span-4" rowSpan="md:row-span-1 lg:row-span-1" title="XR Learning Analytics Pipeline" body="Zwei Wege, je nachdem ob ein Szenario neu entsteht oder bereits eine App existiert.">
  <section id="xr-pipeline" class="mt-5 grid gap-8 lg:grid-cols-2">
    <div>
      <p class="m-0 text-xs font-semibold uppercase tracking-wide text-muted-foreground">Variante 1</p>
      <h3 class="mt-1 text-xl font-semibold">Wenn noch kein Szenario existiert</h3>
      <ol class="mt-5 space-y-4">
        {
          newScenarioSteps.map((step, index) => (
            <li class="relative pl-10">
              <span class="absolute left-0 top-0 flex h-7 w-7 items-center justify-center rounded-full bg-primary text-xs font-semibold text-primary-foreground">
                {index + 1}
              </span>
              <p class="m-0 font-semibold">{step.title}</p>
              <p class="m-0 text-sm text-muted-foreground">{step.text}</p>
            </li>
          ))
        }
      </ol>
    </div>

    <div>
      <p class="m-0 text-xs font-semibold uppercase tracking-wide text-muted-foreground">Variante 2</p>
      <h3 class="mt-1 text-xl font-semibold">Wenn eine XR-App bereits existiert</h3>
      <ol class="mt-5 space-y-4">
        {
          existingAppSteps.map((step, index) => (
            <li class="relative pl-10">
              <span class="absolute left-0 top-0 flex h-7 w-7 items-center justify-center rounded-full bg-secondary text-xs font-semibold text-secondary-foreground">
                {index + 1}
              </span>
              <p class="m-0 font-semibold">{step.title}</p>
              <p class="m-0 text-sm text-muted-foreground">{step.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="mt-7 grid gap-4 border-t pt-5 text-sm md:grid-cols-3">
    <div>
      <p class="m-0 font-semibold">Liefergegenstand</p>
      <p class="m-0 text-muted-foreground">Nicht nur eine Demo, sondern ein prüfbarer Lern-/Trainingsprozess mit belastbarer technischer Grundlage.</p>
    </div>
    <div>
      <p class="m-0 font-semibold">Datenbasis</p>
      <p class="m-0 text-muted-foreground">Messpunkte, xAPI-/Telemetry-Struktur und Datenqualität werden von Anfang an mitgedacht.</p>
    </div>
    <div>
      <p class="m-0 font-semibold">Entscheidungshilfe</p>
      <p class="m-0 text-muted-foreground">Der Report zeigt, was funktioniert, was verbessert werden sollte und wie der nächste Schritt aussieht.</p>
    </div>
  </section>
</Card>
