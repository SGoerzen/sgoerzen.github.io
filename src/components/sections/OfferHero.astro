---
import {
  ArrowRight,
  BarChart3,
  Boxes,
  DraftingCompass,
  Mail,
  MapPin,
} from "lucide-react";
import { LINKS } from "../../lib/constants";

const offerAreas = [
  {
    title: "Strategie & XR-Konzeption",
    description:
      "Lernziele, Machbarkeit und ein belastbares Szenario mit klarem Messkonzept.",
    href: "#prozess",
    Icon: DraftingCompass,
  },
  {
    title: "Entwicklung & Integration",
    description:
      "XR-Piloten mit Unity oder WebXR – anschlussfähig an deine vorhandenen Systeme.",
    href: "#prozess",
    Icon: Boxes,
  },
  {
    title: "Analytics & Evaluation",
    description:
      "xAPI, Datenqualität und Reports, die Wirkung und nächste Schritte sichtbar machen.",
    href: "#prozess",
    Icon: BarChart3,
  },
];
---

<section class="offer-hero" aria-labelledby="offer-heading">
  <div class="hero-stage">
    <div class="hero-background" aria-hidden="true">
      <img src="/header.jpg" alt="" />
    </div>
    <div class="hero-wash" aria-hidden="true"></div>
    <div class="hero-glow" aria-hidden="true"></div>

    <img
      class="hero-portrait"
      src="/me_full.png"
      alt="Dr.-Ing. Sergej Görzen"
      width="1254"
      height="1254"
      decoding="async"
    />

    <div class="hero-inner">
      <div class="hero-copy">
        <p class="eyebrow">XR. Lernen. Wirkung.</p>
        <h1 id="offer-heading">
          Messbare XR-Lern- <span>&amp;</span><br />Trainingslösungen
        </h1>
        <p class="hero-description">
          Konzeption, Entwicklung und Learning Analytics aus einer Hand – für
          XR-Szenarien, die didaktisch funktionieren und belastbare Erkenntnisse
          liefern.
        </p>

        <div class="hero-actions">
          <button
            type="button"
            class="primary-action"
            data-open-dialog="contact-form"
            aria-haspopup="dialog"
            aria-controls="contact-form"
          >
            Projekt anfragen
            <ArrowRight size={18} aria-hidden="true" />
          </button>
          <a class="secondary-action" href="#prozess">
            Leistungen ansehen
            <ArrowRight size={18} aria-hidden="true" />
          </a>
        </div>
      </div>
    </div>
  </div>

  <div
    class="overview-grid"
    aria-label="Leistungsüberblick und Ansprechpartner"
  >
    {
      offerAreas.map(({ title, description, href, Icon }) => (
        <a class="offer-tile" href={href}>
          <Icon size={30} strokeWidth={1.7} aria-hidden="true" />
          <h2>{title}</h2>
          <p>{description}</p>
          <span class="tile-arrow" aria-hidden="true">
            <ArrowRight size={21} />
          </span>
        </a>
      ))
    }

    <aside class="contact-tile" id="kontakt" aria-label="Ansprechpartner">
      <p class="contact-label">Dein Ansprechpartner</p>
      <h2>Dr.-Ing. Sergej Görzen</h2>
      <p class="contact-description">
        XR Learning Analytics &amp; Software Engineering
      </p>
      <div class="contact-details">
        <span
          ><MapPin size={17} aria-hidden="true" /> Reichshof &amp; Remote</span
        >
        <a href={LINKS.mail}
          ><Mail size={17} aria-hidden="true" /> sergej@goerzen.consulting</a
        >
      </div>
    </aside>
  </div>
</section>

<style>
  .offer-hero {
    --hero-blue: #0965df;
    --hero-blue-dark: #0055c8;
    --hero-action: #0965df;
    --hero-action-hover: #0055c8;
    --hero-navy: #061f3d;
    --hero-muted: #526684;
    --hero-stage-background: #eef5fd;
    --hero-stage-border: #dbe5f1;
    --hero-eyebrow-background: #eaf3ff;
    --hero-tile-background: rgba(255, 255, 255, 0.98);
    --hero-tile-border: #dce5f0;
    --hero-tile-muted: #5a6c86;
    --hero-tile-hover-border: #9fc5f8;
    --hero-tile-shadow: 0 16px 42px rgba(12, 42, 78, 0.08);
    --hero-tile-hover-shadow: 0 22px 46px rgba(12, 64, 128, 0.13);
    --hero-secondary-border: #76aaf0;
    position: relative;
    width: 100%;
    margin-bottom: 7.75rem;
    color: var(--hero-navy);
  }

  .hero-stage {
    position: relative;
    min-height: 42.5rem;
    overflow: hidden;
    border-bottom: 1px solid var(--hero-stage-border);
    background: var(--hero-stage-background);
  }

  .hero-background,
  .hero-wash,
  .hero-glow {
    position: absolute;
    inset: 0;
  }

  .hero-background img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 73% center;
    filter: saturate(0.82) contrast(0.93);
  }

  .hero-wash {
    background:
      linear-gradient(
        90deg,
        #fff 0%,
        rgba(255, 255, 255, 0.98) 26%,
        rgba(247, 251, 255, 0.82) 49%,
        rgba(233, 244, 255, 0.25) 68%,
        rgba(8, 64, 125, 0.02) 100%
      ),
      linear-gradient(
        180deg,
        rgba(255, 255, 255, 0.28),
        rgba(225, 239, 255, 0.2)
      );
  }

  .hero-glow {
    left: 35%;
    width: 36%;
    background: radial-gradient(
      circle at center,
      rgba(255, 255, 255, 0.85),
      transparent 69%
    );
    filter: blur(18px);
  }

  .hero-inner {
    position: relative;
    z-index: 4;
    width: min(92%, 90rem);
    margin: 0 auto;
    padding-top: 5.25rem;
  }

  .hero-copy {
    width: min(47rem, 52%);
  }

  .eyebrow {
    display: inline-flex;
    margin: 0 0 1.9rem;
    border-radius: 0.25rem;
    background: var(--hero-eyebrow-background);
    padding: 0.65rem 1rem;
    color: var(--hero-blue-dark);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 48rem;
    margin: 0;
    color: var(--hero-navy);
    font-size: clamp(3rem, 4.35vw, 4.85rem);
    font-weight: 700;
    letter-spacing: -0.045em;
    line-height: 1.07;
  }

  h1 span {
    color: var(--hero-blue);
  }

  .hero-description {
    max-width: 42rem;
    margin: 1.55rem 0 0;
    color: var(--hero-muted);
    font-size: clamp(1.08rem, 1.35vw, 1.32rem);
    line-height: 1.6;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: 2rem;
    margin-top: 2.5rem;
  }

  .primary-action,
  .secondary-action {
    display: inline-flex;
    min-height: 3.5rem;
    align-items: center;
    justify-content: center;
    gap: 0.7rem;
    font-size: 0.98rem;
    font-weight: 700;
    transition: 180ms ease;
  }

  .primary-action {
    min-width: 13.5rem;
    border: 1px solid var(--hero-action);
    border-radius: 0.22rem;
    background: var(--hero-action);
    padding: 0 1.45rem;
    color: #fff;
    box-shadow: 0 10px 30px rgba(9, 101, 223, 0.2);
  }

  .primary-action:hover {
    transform: translateY(-2px);
    border-color: var(--hero-action-hover);
    background: var(--hero-action-hover);
    box-shadow: 0 14px 34px rgba(9, 101, 223, 0.27);
  }

  .secondary-action {
    min-height: 2.4rem;
    border-bottom: 2px solid var(--hero-secondary-border);
    color: var(--hero-blue-dark);
  }

  .secondary-action:hover {
    gap: 1rem;
    border-color: var(--hero-blue-dark);
  }

  .hero-portrait {
    position: absolute;
    z-index: 3;
    top: 2.5rem;
    right: 5%;
    width: auto;
    height: min(46vw, 38rem);
    object-fit: contain;
    object-position: top center;
    filter: contrast(1.02) saturate(0.96);
  }

  .overview-grid {
    position: absolute;
    z-index: 8;
    left: 50%;
    bottom: -5.45rem;
    display: grid;
    width: min(92%, 90rem);
    transform: translateX(-50%);
    grid-template-columns: repeat(3, minmax(0, 1fr)) 1.12fr;
    align-items: stretch;
    gap: 1.45rem;
  }

  .offer-tile,
  .contact-tile {
    min-height: 13.25rem;
    border-radius: 0.22rem;
    padding: 1.75rem 1.65rem;
  }

  .offer-tile {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--hero-tile-border);
    background: var(--hero-tile-background);
    color: var(--hero-navy);
    box-shadow: var(--hero-tile-shadow);
    transition: 180ms ease;
  }

  .offer-tile > svg {
    color: var(--hero-blue);
  }

  .offer-tile h2,
  .contact-tile h2 {
    margin: 1rem 0 0;
    font-size: 1.02rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .offer-tile p {
    margin: 0.55rem 0 0;
    color: var(--hero-tile-muted);
    font-size: 0.82rem;
    line-height: 1.55;
  }

  .tile-arrow {
    display: flex;
    margin-top: auto;
    color: var(--hero-blue);
  }

  .offer-tile:hover {
    transform: translateY(-4px);
    border-color: var(--hero-tile-hover-border);
    box-shadow: var(--hero-tile-hover-shadow);
  }

  .contact-tile {
    background: linear-gradient(145deg, #092b50, #031a34);
    color: #fff;
    box-shadow: 0 20px 50px rgba(3, 26, 52, 0.25);
  }

  .contact-label {
    margin: 0;
    color: #d3e6ff;
    font-size: 0.78rem;
  }

  .contact-tile h2 {
    margin-top: 0.45rem;
    font-size: 1.25rem;
  }

  .contact-description {
    margin: 0.55rem 0 0;
    color: #c8d6e8;
    font-size: 0.8rem;
    line-height: 1.5;
  }

  .contact-details {
    display: grid;
    gap: 0.55rem;
    margin-top: 1.15rem;
    font-size: 0.75rem;
  }

  .contact-details span,
  .contact-details a {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    color: #fff;
  }

  .contact-details a:hover {
    color: #9dc8ff;
  }

  :global(.dark) .offer-hero {
    --hero-blue: #69adff;
    --hero-blue-dark: #91c4ff;
    --hero-action: #1473e6;
    --hero-action-hover: #2684f2;
    --hero-navy: #edf5ff;
    --hero-muted: #b3c2d5;
    --hero-stage-background: #07111f;
    --hero-stage-border: #24364d;
    --hero-eyebrow-background: rgba(55, 139, 238, 0.14);
    --hero-tile-background: rgba(14, 27, 44, 0.98);
    --hero-tile-border: #2a3d55;
    --hero-tile-muted: #aebed1;
    --hero-tile-hover-border: #4d83bd;
    --hero-tile-shadow: 0 18px 44px rgba(0, 0, 0, 0.28);
    --hero-tile-hover-shadow: 0 24px 50px rgba(0, 0, 0, 0.38);
    --hero-secondary-border: #397ecb;
  }

  :global(.dark) .hero-background img {
    filter: brightness(0.62) saturate(0.72) contrast(1.06);
  }

  :global(.dark) .hero-wash {
    background:
      linear-gradient(
        90deg,
        rgba(5, 13, 24, 0.99) 0%,
        rgba(5, 14, 26, 0.96) 28%,
        rgba(6, 17, 31, 0.84) 50%,
        rgba(7, 22, 40, 0.5) 70%,
        rgba(5, 18, 34, 0.24) 100%
      ),
      linear-gradient(180deg, rgba(4, 11, 20, 0.35), rgba(4, 11, 20, 0.6));
  }

  :global(.dark) .hero-glow {
    background: radial-gradient(
      circle at center,
      rgba(63, 137, 222, 0.16),
      transparent 69%
    );
  }

  @media (max-width: 1180px) {
    .hero-stage {
      min-height: 40rem;
    }

    .hero-inner {
      padding-top: 4.5rem;
    }

    .hero-copy {
      width: 58%;
    }

    .hero-portrait {
      top: 2.5rem;
      right: -1%;
      height: min(56vw, 35rem);
    }

    .overview-grid {
      position: relative;
      left: auto;
      bottom: auto;
      width: min(92%, 90rem);
      margin: -3.5rem auto 0;
      transform: none;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .offer-hero {
      margin-bottom: 4.5rem;
    }
  }

  @media (max-width: 760px) {
    .offer-hero {
      margin-bottom: 3.5rem;
    }

    .hero-stage {
      min-height: 43rem;
    }

    .hero-background img {
      object-position: 70% center;
    }

    .hero-wash {
      background:
        linear-gradient(
          180deg,
          #fff 0%,
          rgba(255, 255, 255, 0.97) 44%,
          rgba(238, 247, 255, 0.82) 71%,
          rgba(216, 235, 255, 0.58) 100%
        ),
        linear-gradient(90deg, #fff, rgba(255, 255, 255, 0.3));
    }

    :global(.dark) .hero-wash {
      background:
        linear-gradient(
          180deg,
          rgba(5, 13, 24, 0.99) 0%,
          rgba(5, 14, 26, 0.97) 45%,
          rgba(7, 20, 37, 0.88) 72%,
          rgba(8, 26, 48, 0.7) 100%
        ),
        linear-gradient(90deg, #050d18, rgba(5, 13, 24, 0.48));
    }

    .hero-glow {
      display: none;
    }

    .hero-inner {
      width: min(90%, 40rem);
      padding-top: 3.25rem;
    }

    .hero-copy {
      width: 100%;
    }

    .eyebrow {
      margin-bottom: 1.35rem;
      padding: 0.55rem 0.75rem;
      font-size: 0.66rem;
    }

    h1 {
      font-size: clamp(2.55rem, 12vw, 3.65rem);
      line-height: 1.04;
    }

    .hero-description {
      margin-top: 1.2rem;
      font-size: 1rem;
      line-height: 1.55;
    }

    .hero-actions {
      align-items: stretch;
      gap: 1rem;
      margin-top: 1.75rem;
    }

    .primary-action {
      min-width: 0;
    }

    .secondary-action {
      font-size: 0.85rem;
    }

    .hero-portrait {
      top: auto;
      right: -3rem;
      bottom: -1.5rem;
      height: 20rem;
      opacity: 0.86;
    }

    .overview-grid {
      width: min(92%, 40rem);
      margin-top: 1rem;
      grid-template-columns: 1fr;
      gap: 0.85rem;
    }

    .offer-tile,
    .contact-tile {
      min-height: auto;
      padding: 1.4rem;
    }

    .offer-tile {
      display: grid;
      grid-template-columns: auto 1fr auto;
      column-gap: 1rem;
      align-items: center;
    }

    .offer-tile h2 {
      margin: 0;
    }

    .offer-tile p {
      grid-column: 2 / 4;
    }

    .tile-arrow {
      grid-column: 3;
      grid-row: 1;
      margin: 0;
    }
  }

  @media (max-width: 480px) {
    .hero-stage {
      min-height: 45rem;
    }

    .hero-actions {
      flex-direction: column;
      align-items: flex-start;
    }

    .primary-action {
      width: 100%;
    }

    .hero-portrait {
      top: auto;
      right: -4.5rem;
      height: 19rem;
    }
  }
</style>
