---
import { ArrowUpRight, Presentation } from 'lucide-react'

const workshopReferences = [
  {
    year: '2025',
    title: 'OmiLAXR Workshop',
    detail: 'Hands-on · xAPI · Unity/XR',
    url: 'https://learntech.rwth-aachen.de/go/id/bmskgg',
  },
  {
    year: '2022–2024',
    title: 'Nuts & Bolts @ DELFI',
    detail: 'Jährliche Workshop-Reihe zu Bildungstechnologien',
    url: 'https://learntech.rwth-aachen.de/cms/learntech/forschung/lti-lab/workshops/~bgxeol/delfi2024-workshop-nutsandbolts/',
  },
  {
    year: '2025',
    title: 'LAVR @ LAK25',
    detail: 'Mitorganisation · Learning Analytics & VR · Dublin',
    url: 'https://hlostam.github.io/lavr-lak25/',
  },
]
---

<article
  class="group flex h-full flex-col rounded-2xl border border-orange-200/70 bg-orange-50/60 p-5 transition duration-200 hover:-translate-y-0.5 hover:border-primary/50 hover:shadow-md dark:border-orange-900/70 dark:bg-orange-950/20"
>
  <div
    class="flex h-10 w-10 items-center justify-center rounded-xl bg-orange-100 text-orange-700 dark:bg-orange-900/60 dark:text-orange-300"
  >
    <Presentation size={20} aria-hidden="true" />
  </div>

  <p class="mt-5 text-xs font-semibold uppercase tracking-[0.14em] text-muted-foreground">
    Wissenstransfer · 2022–2025
  </p>
  <h3 class="mt-1 text-lg font-semibold tracking-tight">Durchgeführte Workshops</h3>
  <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
    Praxisnaher Transfer zu OmiLAXR, Learning Analytics und nachhaltigen Bildungstechnologien.
  </p>

  <ul class="mt-4 space-y-2">
    {
      workshopReferences.map(({ year, title, detail, url }) => (
        <li>
          <a
            href={url}
            target="_blank"
            rel="noreferrer"
            class="group/reference flex items-start gap-3 rounded-xl border border-foreground/10 bg-background/70 p-3 transition hover:border-primary/40 hover:bg-primary/5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
          >
            <span class="min-w-0 flex-1">
              <span class="block text-[0.68rem] font-semibold uppercase tracking-[0.12em] text-primary">
                {year}
              </span>
              <span class="mt-0.5 block text-sm font-semibold">{title}</span>
              <span class="mt-1 block text-xs leading-relaxed text-muted-foreground">{detail}</span>
            </span>
            <ArrowUpRight
              size={15}
              className="mt-0.5 shrink-0 text-muted-foreground transition group-hover/reference:text-primary"
              aria-hidden="true"
            />
          </a>
        </li>
      ))
    }
  </ul>
</article>
