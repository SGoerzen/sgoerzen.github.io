---
import { ArrowUpRight, BookOpen, X } from 'lucide-react'

interface Resource {
  label: string
  url: string
}

interface Props {
  dialogId: string
  title: string
  buttonLabel: string
  resources: Resource[]
}

const { dialogId, title, buttonLabel, resources } = Astro.props as Props
---

<div class="mt-4">
  <button
    type="button"
    class="inline-flex w-full items-center justify-between gap-3 rounded-xl border border-foreground/10 bg-background/70 px-3 py-2.5 text-left text-sm font-semibold text-primary transition hover:border-primary/50 hover:bg-primary/5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2"
    data-open-project-resources={dialogId}
    aria-haspopup="dialog"
    aria-controls={dialogId}
  >
    <span class="inline-flex items-center gap-2">
      <BookOpen size={16} aria-hidden="true" />
      {buttonLabel}
    </span>
    <span aria-hidden="true">→</span>
  </button>

  <dialog
    id={dialogId}
    data-project-resources-dialog
    aria-labelledby={`${dialogId}-title`}
    class="fixed left-1/2 top-1/2 m-0 w-[min(44rem,calc(100vw-2rem))] max-w-none -translate-x-1/2 -translate-y-1/2 overflow-hidden rounded-2xl border border-border bg-background p-0 text-foreground shadow-2xl"
  >
    <div class="flex items-start justify-between gap-4 border-b p-5">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.14em] text-primary">Wissenschaftliche Weiterentwicklung</p>
        <h2 id={`${dialogId}-title`} class="mt-1 text-xl font-semibold tracking-tight">{title}</h2>
        <p class="mt-2 text-sm text-muted-foreground">{resources.length} wissenschaftliche Abschlussarbeiten und Weiterentwicklungen.</p>
      </div>
      <button
        type="button"
        class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border transition hover:bg-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
        data-close-project-resources={dialogId}
        aria-label="Dialog schließen"
      >
        <X size={17} aria-hidden="true" />
      </button>
    </div>

    <ol class="max-h-[min(65vh,38rem)] space-y-2 overflow-y-auto p-5">
      {
        resources.map((resource, index) => (
          <li>
            <a
              href={resource.url}
              target="_blank"
              rel="noreferrer"
              class="group/resource flex items-start gap-3 rounded-xl border border-foreground/10 bg-muted/30 p-3 transition hover:border-primary/40 hover:bg-primary/5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
            >
              <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-primary/10 text-xs font-semibold text-primary">
                {index + 1}
              </span>
              <span class="min-w-0 flex-1 text-sm font-medium leading-relaxed">{resource.label}</span>
              <ArrowUpRight
                size={15}
                className="mt-1 shrink-0 text-muted-foreground transition group-hover/resource:text-primary"
                aria-hidden="true"
              />
            </a>
          </li>
        ))
      }
    </ol>
  </dialog>
</div>

<script is:inline>
  (() => {
    const setupProjectResourceDialogs = () => {
      document.querySelectorAll('[data-open-project-resources]').forEach((button) => {
        if (button.dataset.projectResourcesBound === '1') return
        button.dataset.projectResourcesBound = '1'

        button.addEventListener('click', (event) => {
          event.preventDefault()
          event.stopPropagation()

          const id = button.getAttribute('data-open-project-resources')
          const dialog = id ? document.getElementById(id) : null
          if (!dialog) return

          dialog._projectResourcesTrigger = button
          if (typeof dialog.showModal === 'function') dialog.showModal()
          else dialog.setAttribute('open', 'true')
        })
      })

      document.querySelectorAll('[data-project-resources-dialog]').forEach((dialog) => {
        if (dialog.dataset.projectResourcesBound === '1') return
        dialog.dataset.projectResourcesBound = '1'

        const closeDialog = () => {
          if (dialog.open) dialog.close()
          else dialog.removeAttribute('open')
          dialog._projectResourcesTrigger?.focus()
        }

        dialog.querySelector('[data-close-project-resources]')?.addEventListener('click', closeDialog)
        dialog.addEventListener('cancel', (event) => {
          event.preventDefault()
          closeDialog()
        })
        dialog.addEventListener('click', (event) => {
          const bounds = dialog.getBoundingClientRect()
          const isInside =
            bounds.top <= event.clientY &&
            event.clientY <= bounds.bottom &&
            bounds.left <= event.clientX &&
            event.clientX <= bounds.right

          if (!isInside) closeDialog()
        })
      })
    }

    setupProjectResourceDialogs()
    document.addEventListener('astro:after-swap', setupProjectResourceDialogs)
  })()
</script>

<style is:global>
  dialog[data-project-resources-dialog]::backdrop {
    background: rgb(0 0 0 / 0.55);
    backdrop-filter: blur(3px);
  }
</style>
