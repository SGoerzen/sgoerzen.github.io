---
import { ArrowUpRight, Boxes, Camera, FlaskConical, GraduationCap, MapPinned, Network } from 'lucide-react'

interface Project {
  slug: string
  category: string
  featured?: boolean
  title: string
  focus: string
  organization: string
  url?: string
  image?: string
  imageAlt?: string
  summary: string
  note?: string
  challenge?: string
  description: string
  outcome?: string
  metrics?: Array<{
    value: string
    label: string
    detail: string
  }>
  tags: string[]
}

interface Props {
  project: Project
  compact?: boolean
}

const { project, compact = false } = Astro.props as Props

const visuals = {
  'repix-vr': {
    icon: Boxes,
    surface: 'border-sky-200/70 bg-sky-50/60 dark:border-sky-900/70 dark:bg-sky-950/20',
    iconColor: 'bg-sky-100 text-sky-700 dark:bg-sky-900/60 dark:text-sky-300',
  },
  'teach-r': {
    icon: GraduationCap,
    surface: 'border-violet-200/70 bg-violet-50/60 dark:border-violet-900/70 dark:bg-violet-950/20',
    iconColor: 'bg-violet-100 text-violet-700 dark:bg-violet-900/60 dark:text-violet-300',
  },
  'inside-the-router': {
    icon: Network,
    surface: 'border-amber-200/70 bg-amber-50/60 dark:border-amber-900/70 dark:bg-amber-950/20',
    iconColor: 'bg-amber-100 text-amber-700 dark:bg-amber-900/60 dark:text-amber-300',
  },
  'schuelerlarbor': {
    icon: FlaskConical,
    surface: 'border-emerald-200/70 bg-emerald-50/60 dark:border-emerald-900/70 dark:bg-emerald-950/20',
    iconColor: 'bg-emerald-100 text-emerald-700 dark:bg-emerald-900/60 dark:text-emerald-300',
  },
  'ar-routen': {
    icon: MapPinned,
    surface: 'border-teal-200/70 bg-teal-50/60 dark:border-teal-900/70 dark:bg-teal-950/20',
    iconColor: 'bg-teal-100 text-teal-700 dark:bg-teal-900/60 dark:text-teal-300',
  },
  'virtual-booth': {
    icon: Camera,
    surface: 'border-fuchsia-200/70 bg-fuchsia-50/60 dark:border-fuchsia-900/70 dark:bg-fuchsia-950/20',
    iconColor: 'bg-fuchsia-100 text-fuchsia-700 dark:bg-fuchsia-900/60 dark:text-fuchsia-300',
  },
}

const visual = visuals[project.slug as keyof typeof visuals] ?? visuals['repix-vr']
const ProjectIcon = visual.icon
const CardTag = project.url ? 'a' : 'article'
const isExternal = project.url?.startsWith('http')
const metricStyles = [
  'border-violet-200 bg-violet-100/80 dark:border-violet-800 dark:bg-violet-950/50',
  'border-cyan-200 bg-cyan-100/80 dark:border-cyan-800 dark:bg-cyan-950/50',
  'border-emerald-200 bg-emerald-100/80 dark:border-emerald-800 dark:bg-emerald-950/50',
  'border-lime-200 bg-lime-100/80 dark:border-lime-800 dark:bg-lime-950/50',
]
---

<CardTag
  href={project.url}
  target={isExternal ? '_blank' : undefined}
  rel={isExternal ? 'noreferrer' : undefined}
  class={`group flex h-full flex-col rounded-2xl border p-5 transition duration-200 hover:-translate-y-0.5 hover:border-primary/50 hover:shadow-md ${visual.surface} ${project.featured ? 'md:col-span-2' : ''}`}
>
  <div class="flex items-start justify-between gap-4">
    <div class={`flex h-10 w-10 items-center justify-center rounded-xl ${visual.iconColor}`}>
      <ProjectIcon size={20} aria-hidden="true" />
    </div>
    {project.url && <ArrowUpRight size={18} className="text-muted-foreground transition group-hover:text-primary" aria-hidden="true" />}
  </div>

  {
    project.image && (
      <div class="mt-5 overflow-hidden rounded-xl border border-foreground/10 bg-background/60">
        <img
          src={project.image}
          alt={project.imageAlt ?? ''}
          loading="lazy"
          decoding="async"
          class="aspect-video w-full object-contain"
        />
      </div>
    )
  }

  <p class={`${project.image ? 'mt-4' : 'mt-5'} text-xs font-semibold uppercase tracking-[0.14em] text-muted-foreground`}>{project.focus}</p>
  <h3 class="mt-1 text-lg font-semibold tracking-tight">{project.title}</h3>
  <p class="mt-1 text-xs text-muted-foreground">{project.organization}</p>

  {
    compact ? (
      <p class="mt-4 text-sm leading-relaxed text-muted-foreground">{project.summary}</p>
    ) : project.challenge ? (
      <div class="mt-5 grid gap-4 lg:grid-cols-2">
        <section class="rounded-xl border border-foreground/10 bg-background/60 p-4">
          <p class="text-xs font-semibold uppercase tracking-[0.14em] text-muted-foreground">Herausforderung</p>
          <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{project.challenge}</p>
        </section>
        <section class="rounded-xl border border-primary/20 bg-primary/5 p-4">
          <p class="text-xs font-semibold uppercase tracking-[0.14em] text-primary">Lösung & Beitrag</p>
          <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{project.description}</p>
        </section>
      </div>
    ) : (
      <p class="mt-4 text-sm leading-relaxed text-muted-foreground md:min-h-20">{project.description}</p>
    )
  }

  {
    project.note && (
      <p class="mt-3 border-l-2 border-foreground/15 pl-3 text-xs italic leading-relaxed text-muted-foreground">
        {project.note}
      </p>
    )
  }

  {
    !compact && project.outcome && (
      <section class="mt-4 rounded-xl border border-primary/20 bg-background/70 p-4">
        <p class="text-xs font-semibold uppercase tracking-[0.14em] text-primary">Nachgewiesene Wirkung</p>
        <p class="mt-2 text-sm font-medium leading-relaxed">{project.outcome}</p>
      </section>
    )
  }

  {
    !compact && project.metrics && (
      <div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-4" aria-label="Projektergebnisse">
        {project.metrics.map((metric, index) => (
          <div class={`rounded-xl border p-4 ${metricStyles[index % metricStyles.length]}`}>
            <p class="text-xl font-bold tracking-tight">{metric.value}</p>
            <p class="mt-1 text-sm font-semibold">{metric.label}</p>
            <p class="mt-2 text-xs leading-relaxed text-muted-foreground">{metric.detail}</p>
          </div>
        ))}
      </div>
    )
  }

  <div class="mt-auto flex flex-wrap gap-2 pt-5">
    {project.tags.map((tag) => (
      <span class="rounded-full border border-foreground/10 bg-background/70 px-2.5 py-1 text-[0.7rem] font-medium text-muted-foreground">
        {tag}
      </span>
    ))}
  </div>
</CardTag>
