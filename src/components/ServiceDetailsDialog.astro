---
import { ArrowRight, Clock3, X } from 'lucide-react'

interface Props {
  dialogId: string
  title: string
  price: string
  description: string
  duration: string
  deliverables: string[]
  customerInput: string
  costDrivers: string[]
  notIncluded: string[]
  compact?: boolean
}

const {
  dialogId,
  title,
  price,
  description,
  duration,
  deliverables,
  customerInput,
  costDrivers,
  notIncluded,
  compact = false,
} = Astro.props as Props
---

<div class:list={[compact ? 'mt-3' : 'mt-auto pt-5']}>
  <button
    type="button"
    class:list={[
      'group/details inline-flex items-center font-semibold text-primary transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2',
      compact
        ? 'gap-1 rounded text-xs hover:underline'
        : 'w-full justify-between gap-3 rounded-lg border px-3 py-2.5 text-left text-sm hover:border-primary/45 hover:bg-primary/5',
    ]}
    data-open-service-dialog={dialogId}
    aria-haspopup="dialog"
    aria-controls={dialogId}
  >
    {compact ? 'Details' : 'Details ansehen'}
    <ArrowRight
      size={16}
      className="transition-transform group-hover/details:translate-x-0.5"
      aria-hidden="true"
    />
  </button>

  <dialog
    id={dialogId}
    data-service-dialog
    aria-labelledby={`${dialogId}-title`}
    class="fixed left-1/2 top-1/2 m-0 max-h-[calc(100vh-2rem)] w-[min(46rem,calc(100vw-2rem))] max-w-none -translate-x-1/2 -translate-y-1/2 overflow-hidden rounded-2xl border border-border bg-background p-0 text-foreground shadow-2xl"
  >
    <header class="flex items-start justify-between gap-4 border-b p-5">
      <div>
        <p class="m-0 text-xs font-semibold uppercase tracking-[0.14em] text-primary">Paketdetails</p>
        <h2 id={`${dialogId}-title`} class="mb-0 mt-1 text-xl font-semibold tracking-tight">{title}</h2>
        <p class="mb-0 mt-2 text-sm font-semibold text-primary">{price}</p>
      </div>
      <button
        type="button"
        class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border transition hover:bg-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
        data-close-service-dialog
        aria-label="Dialog schließen"
      >
        <X size={17} aria-hidden="true" />
      </button>
    </header>

    <div class="max-h-[min(70vh,42rem)] overflow-y-auto p-5">
      <p class="m-0 text-sm leading-relaxed text-muted-foreground">{description}</p>

      <div class="mt-4 flex items-center gap-2 rounded-lg bg-primary/5 px-3 py-2 text-sm">
        <Clock3 size={16} className="shrink-0 text-primary" aria-hidden="true" />
        <span><strong class="font-semibold">Zeitrahmen:</strong> {duration}</span>
      </div>

      <div class="mt-5 grid gap-5 sm:grid-cols-2">
        <section>
          <h3 class="m-0 text-sm font-semibold">Du erhältst</h3>
          <ul class="mt-2 list-disc space-y-1.5 pl-5 text-sm leading-relaxed text-muted-foreground">
            {deliverables.map((item) => <li>{item}</li>)}
          </ul>
        </section>

        <section>
          <h3 class="m-0 text-sm font-semibold">Von Kundenseite</h3>
          <p class="mb-0 mt-2 text-sm leading-relaxed text-muted-foreground">{customerInput}</p>
        </section>

        <section>
          <h3 class="m-0 text-sm font-semibold">Wichtige Kostentreiber</h3>
          <ul class="mt-2 list-disc space-y-1.5 pl-5 text-sm leading-relaxed text-muted-foreground">
            {costDrivers.map((item) => <li>{item}</li>)}
          </ul>
        </section>

        <section>
          <h3 class="m-0 text-sm font-semibold">Nicht enthalten</h3>
          <ul class="mt-2 list-disc space-y-1.5 pl-5 text-sm leading-relaxed text-muted-foreground">
            {notIncluded.map((item) => <li>{item}</li>)}
          </ul>
        </section>
      </div>
    </div>
  </dialog>
</div>

<script>
  const setupServiceDialogs = () => {
    document.querySelectorAll<HTMLButtonElement>('[data-open-service-dialog]').forEach((trigger) => {
      if (trigger.dataset.serviceDialogBound === '1') return
      trigger.dataset.serviceDialogBound = '1'

      const dialogId = trigger.dataset.openServiceDialog
      const dialog = dialogId ? document.getElementById(dialogId) as HTMLDialogElement | null : null
      if (!dialog) return

      trigger.addEventListener('click', () => {
        if (typeof dialog.showModal === 'function') dialog.showModal()
        else dialog.setAttribute('open', 'true')
      })
    })

    document.querySelectorAll<HTMLDialogElement>('[data-service-dialog]').forEach((dialog) => {
      if (dialog.dataset.serviceDialogBound === '1') return
      dialog.dataset.serviceDialogBound = '1'

      const trigger = document.querySelector<HTMLButtonElement>(`[data-open-service-dialog="${dialog.id}"]`)
      const closeDialog = () => {
        if (dialog.open) dialog.close()
        else dialog.removeAttribute('open')
        trigger?.focus()
      }

      dialog.querySelector('[data-close-service-dialog]')?.addEventListener('click', closeDialog)
      dialog.addEventListener('cancel', (event) => {
        event.preventDefault()
        closeDialog()
      })
      dialog.addEventListener('click', (event) => {
        const bounds = dialog.getBoundingClientRect()
        const isInside =
          bounds.top <= event.clientY &&
          event.clientY <= bounds.bottom &&
          bounds.left <= event.clientX &&
          event.clientX <= bounds.right

        if (!isInside) closeDialog()
      })
    })
  }

  setupServiceDialogs()
  document.addEventListener('astro:after-swap', setupServiceDialogs)
</script>

<style is:global>
  dialog[data-service-dialog]::backdrop {
    background: rgb(0 0 0 / 0.55);
    backdrop-filter: blur(3px);
  }
</style>
