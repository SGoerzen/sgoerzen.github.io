---
import BaseLayout from "../layouts/BaseLayout.astro";
import ExperienceCard from "../components/sections/ExperienceCard.astro";
import OfferHero from "../components/sections/OfferHero.astro";
import XRPipelineCard from "../components/sections/XRPipelineCard.astro";
import ProjectTeamCard from "../components/sections/ProjectTeamCard.astro";
---

<BaseLayout
  title="Dr.-Ing. Sergej Görzen | XR Learning Analytics · Training · Evaluation"
  description="XR-Lern- und Trainingsszenarien von der Anforderungsanalyse über Unity, Three.js und WebXR bis zu Learning Analytics, Evaluation und Report."
>
  <main class="offer-home w-full overflow-hidden">
    <OfferHero />

    <div
      class="home-sections relative m-auto grid w-full max-w-[90rem] gap-6 px-[4%] pb-16 md:grid-cols-2 lg:grid-cols-4"
    >
      <XRPipelineCard />
      <ExperienceCard />
      <ProjectTeamCard />
    </div>
  </main>
</BaseLayout>

<style>
  .offer-home {
    background: linear-gradient(180deg, #ffffff 0%, #f7faff 52%, #ffffff 100%);
  }

  .home-sections :global(.card-animate) {
    border-color: #dce5f0;
    border-radius: 0.3rem;
    box-shadow: 0 14px 38px rgba(12, 42, 78, 0.06);
  }
</style>
