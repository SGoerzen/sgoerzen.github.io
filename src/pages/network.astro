---
import { ArrowRight, BarChart3, Box, Code2, Palette } from "lucide-react";
import { buttonVariants } from "../components/ui/button";
import BaseLayout from "../layouts/BaseLayout.astro";
import BottomLayout from "../layouts/BottomLayout.astro";
import TopLayout from "../layouts/TopLayout.astro";
import { LINKS } from "../lib/constants";
import { NETWORK_SPECIALISTS } from "../lib/network";

const specialties = [
  {
    title: "3D & Spatial Design",
    description:
      "3D-Modelle, Animationen, Umgebungen und optimierte Assets für VR-, AR- und WebXR-Anwendungen.",
    icon: Box,
  },
  {
    title: "UX & Interaction Design",
    description:
      "Nutzerführung, Interface- und Interaktionskonzepte für verständliche und zugängliche XR-Erlebnisse.",
    icon: Palette,
  },
  {
    title: "Softwareentwicklung",
    description:
      "Zusätzliche Entwicklungskapazität für Unity, Web, Backend, Integrationen und produktionsnahe Systeme.",
    icon: Code2,
  },
  {
    title: "Datenanalyse & Evaluation",
    description:
      "Unterstützung bei Messkonzepten, statistischer Auswertung, Visualisierung und belastbaren Ergebnisberichten.",
    icon: BarChart3,
  },
];

const collaborationSteps = [
  {
    number: "01",
    title: "Bedarf klären",
    description:
      "Im Scoping wird sichtbar, welche zusätzliche Expertise das Vorhaben tatsächlich benötigt.",
  },
  {
    number: "02",
    title: "Passend ergänzen",
    description:
      "Ich stelle projektbezogen die passenden selbständigen Spezialisten aus meinem Netzwerk zusammen.",
  },
  {
    number: "03",
    title: "Gemeinsam liefern",
    description:
      "Ich koordiniere Schnittstellen, technische Qualität und Delivery als zentraler Ansprechpartner.",
  },
];
---

<BaseLayout
  title="Spezialisten aus meinem Netzwerk | Dr.-Ing. Sergej Görzen"
  description="Projektbezogene Zusammenarbeit mit selbständigen Spezialisten für 3D, UX, Softwareentwicklung, Datenanalyse und Evaluation."
>
  <main class="flex min-h-[80vh] flex-auto flex-col" transition:animate="fade">
    <TopLayout>
      <p class="text-xs font-semibold uppercase tracking-[0.16em] text-primary">
        Projektbezogene Zusammenarbeit
      </p>
      <h2
        class="mt-2 scroll-m-20 border-b pb-3 text-3xl font-semibold tracking-tight"
      >
        Spezialisten aus meinem Netzwerk
      </h2>
    </TopLayout>

    <BottomLayout>
      <div class="space-y-10">
        <section
          class="overflow-hidden rounded-2xl border bg-gradient-to-br from-primary/10 via-background to-background p-6 md:p-8"
          aria-labelledby="network-intro"
        >
          <h3
            id="network-intro"
            class="max-w-3xl text-2xl font-semibold tracking-tight md:text-3xl"
          >
            Die passende Expertise für jede Projektphase.
          </h3>
          <p
            class="mt-4 max-w-4xl text-sm leading-relaxed text-muted-foreground md:text-base"
          >
            Für Aufgaben, die zusätzliche Expertise verlangen, binde ich
            selbständige Spezialisten aus meinem Netzwerk projektbezogen ein. So
            lassen sich Konzeption, Entwicklung, Design, Datenanalyse und
            Rollout flexibel zu einer ganzheitlichen Lösung verbinden.
          </p>
          <p
            class="mt-3 max-w-4xl text-sm leading-relaxed text-muted-foreground md:text-base"
          >
            Die Spezialisten arbeiten eigenständig und werden passend zu Umfang
            und Anforderungen des jeweiligen Vorhabens ausgewählt. Technische
            Gesamtverantwortung, Koordination und zentrale Kommunikation bleiben
            bei mir.
          </p>
        </section>

        {
          NETWORK_SPECIALISTS.length > 0 && (
            <section aria-labelledby="network-profiles">
              <div class="mb-5 max-w-3xl">
                <p class="text-xs font-semibold uppercase tracking-[0.14em] text-muted-foreground">
                  Profile
                </p>
                <h3 id="network-profiles" class="mt-1 text-xl font-semibold tracking-tight">
                  Selbständige Spezialisten im Netzwerk
                </h3>
              </div>

              <div class="grid gap-4 md:grid-cols-2">
                {NETWORK_SPECIALISTS.map((specialist) => (
                  <article class="rounded-2xl border bg-card p-5 shadow-sm">
                    <div class="flex items-start gap-4">
                      {specialist.image ? (
                        <img
                          src={specialist.image}
                          alt=""
                          class="h-16 w-16 shrink-0 rounded-xl object-cover"
                          loading="lazy"
                        />
                      ) : (
                        <div
                          class="flex h-16 w-16 shrink-0 items-center justify-center rounded-xl bg-primary/10 text-lg font-semibold text-primary"
                          aria-hidden="true"
                        >
                          {specialist.name
                            .split(" ")
                            .map((part) => part[0])
                            .join("")
                            .slice(0, 2)}
                        </div>
                      )}
                      <div class="min-w-0">
                        <h4 class="font-semibold">{specialist.name}</h4>
                        <p class="mt-1 text-sm font-medium text-primary">
                          {specialist.role} · selbständig · projektbezogen
                        </p>
                        <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
                          {specialist.description}
                        </p>
                      </div>
                    </div>
                    <ul class="mt-4 flex flex-wrap gap-2" aria-label={`Kompetenzen von ${specialist.name}`}>
                      {specialist.specialties.map((specialty) => (
                        <li class="rounded-full bg-muted px-3 py-1 text-xs text-muted-foreground">
                          {specialty}
                        </li>
                      ))}
                    </ul>
                    {specialist.website && (
                      <a
                        href={specialist.website}
                        target="_blank"
                        rel="noreferrer"
                        class="mt-4 inline-flex items-center text-sm font-medium text-primary hover:underline"
                      >
                        Eigenes Profil ansehen
                        <ArrowRight className="ml-1 h-4 w-4" aria-hidden="true" />
                      </a>
                    )}
                  </article>
                ))}
              </div>
            </section>
          )
        }

        <section aria-labelledby="network-specialties">
          <div class="mb-5 max-w-3xl">
            <p
              class="text-xs font-semibold uppercase tracking-[0.14em] text-muted-foreground"
            >
              Fachbereiche im Netzwerk
            </p>
            <h3
              id="network-specialties"
              class="mt-1 text-xl font-semibold tracking-tight"
            >
              Ergänzende Kompetenz, wenn das Projekt sie braucht
            </h3>
          </div>

          <div class="grid gap-4 md:grid-cols-2">
            {
              specialties.map(({ title, description, icon: Icon }) => (
                <article class="rounded-2xl border bg-card p-5 shadow-sm">
                  <div class="flex items-start gap-4">
                    <div class="rounded-xl bg-primary/10 p-3 text-primary">
                      <Icon className="h-5 w-5" aria-hidden="true" />
                    </div>
                    <div>
                      <h4 class="font-semibold">{title}</h4>
                      <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
                        {description}
                      </p>
                    </div>
                  </div>
                </article>
              ))
            }
          </div>
        </section>

        <section aria-labelledby="network-process">
          <div class="mb-5 max-w-3xl">
            <p
              class="text-xs font-semibold uppercase tracking-[0.14em] text-muted-foreground"
            >
              Zusammenarbeit
            </p>
            <h3
              id="network-process"
              class="mt-1 text-xl font-semibold tracking-tight"
            >
              Ein Ansprechpartner, gezielt ergänzte Expertise
            </h3>
          </div>

          <ol class="grid gap-4 md:grid-cols-3">
            {
              collaborationSteps.map((step) => (
                <li class="rounded-2xl border p-5">
                  <span class="text-sm font-semibold text-primary">
                    {step.number}
                  </span>
                  <h4 class="mt-3 font-semibold">{step.title}</h4>
                  <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
                    {step.description}
                  </p>
                </li>
              ))
            }
          </ol>
        </section>

        <aside
          class="rounded-2xl border border-primary/20 bg-primary/5 p-6 md:flex md:items-center md:justify-between md:gap-8"
        >
          <div>
            <p
              class="text-xs font-semibold uppercase tracking-[0.14em] text-primary"
            >
              Projekt besprechen
            </p>
            <h3 class="mt-1 text-lg font-semibold">
              Welche Expertise braucht dein Vorhaben?
            </h3>
            <p
              class="mt-2 max-w-3xl text-sm leading-relaxed text-muted-foreground"
            >
              Im Erstgespräch klären wir Ziele, Umfang und die passende
              Zusammensetzung für dein Projekt.
            </p>
          </div>
          <a
            href={LINKS.calendly}
            target="_blank"
            rel="noreferrer"
            class={`${buttonVariants()} mt-5 shrink-0 md:mt-0`}
          >
            Erstgespräch buchen
            <ArrowRight className="ml-2 h-4 w-4" aria-hidden="true" />
          </a>
        </aside>
      </div>
    </BottomLayout>
  </main>
</BaseLayout>
