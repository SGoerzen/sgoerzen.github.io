---
import { WORK, EXPERIENCE, STUDIES } from '../lib/constants'
import BaseLayout from '../layouts/BaseLayout.astro'
import TopLayout from '../layouts/TopLayout.astro'
import BottomLayout from '../layouts/BottomLayout.astro'
---

<BaseLayout title={WORK.TITLE} description={WORK.DESCRIPTION}>
  <main class="flex min-h-[80vh] flex-auto flex-col" transition:animate="fade">
    <TopLayout>
      <h2 class="scroll-m-20 border-b pb-2 text-3xl font-semibold tracking-tight first:mt-0">
        {WORK.TITLE}
      </h2>
    </TopLayout>

    <BottomLayout>
      <section class="rounded-2xl border bg-gradient-to-br from-primary/10 via-background to-background p-6 md:p-8" aria-labelledby="experience-offer">
        <p class="text-xs font-semibold uppercase tracking-[0.16em] text-primary">Erfahrung als Grundlage für dein XR-Projekt</p>
        <h3 id="experience-offer" class="mt-2 max-w-3xl text-2xl font-semibold tracking-tight">
          Von der Anforderung bis zur umgesetzten und evaluierbaren XR-Anwendung
        </h3>
        <p class="mt-3 max-w-4xl text-sm leading-relaxed text-muted-foreground md:text-base">
          Mein heutiges Angebot verbindet langjährige Software- und Delivery-Erfahrung mit Forschung zu XR und Learning Analytics. Ich unterstütze Unternehmen, Hochschulen und Forschungsteams bei einzelnen Arbeitspaketen oder als technischer Partner über den gesamten Projektverlauf.
        </p>

        <div class="mt-6 grid gap-4 md:grid-cols-3">
          <div class="border-t pt-3">
            <p class="font-semibold">XR-Konzeption & Entwicklung</p>
            <p class="mt-1 text-sm leading-relaxed text-muted-foreground">Scoping, Szenariodesign und Umsetzung mit Unity, Three.js und WebXR.</p>
          </div>
          <div class="border-t pt-3">
            <p class="font-semibold">Daten & Evaluation</p>
            <p class="mt-1 text-sm leading-relaxed text-muted-foreground">xAPI, Learning Analytics, Pilotierung, Auswertung und belastbarer Report.</p>
          </div>
          <div class="border-t pt-3">
            <p class="font-semibold">Projekt- & Antragspartnerschaft</p>
            <p class="mt-1 text-sm leading-relaxed text-muted-foreground">Machbarkeit, technische Arbeitspakete, Prototyping und Delivery in Einzel- oder Verbundprojekten.</p>
          </div>
        </div>
      </section>

      <h3 class="mt-10 text-xl font-semibold">Stationen & Verantwortung</h3>
      <ul class="mt-4">
        {
          EXPERIENCE.map((entry) => (
            <li class="animate mt-4 border-b border-black/10 py-8 first-of-type:mt-0 first-of-type:pt-0 last-of-type:border-none dark:border-white/25">
              <div class="mb-2 text-sm uppercase">{entry.start} - {entry.end}</div>
              {entry.link ? (
                <a href={entry.link} target="_blank" class="font-semibold text-primary" rel="noreferrer">
                  {entry.company}
                </a>
              ) : (
                <div class="font-semibold text-foreground">{entry.company}</div>
              )}
              <div class="text-sm font-semibold">{entry.position}</div>
              <div class="text-sm text-muted-foreground">{entry.location}</div>
              <ul class="mt-3 list-disc space-y-1 pl-5 text-sm text-muted-foreground">
                {entry.tasks.map((task) => (
                  <li>{task}</li>
                ))}
              </ul>
            </li>
          ))
        }
      </ul>

      <section class="mt-10">
        <h3 class="text-xl font-semibold">Ausbildung & akademischer Hintergrund</h3>
        <ul class="mt-4">
          {
            STUDIES.map((s) => (
              <li class="animate mt-4 border-b border-black/10 py-6 first-of-type:mt-0 first-of-type:pt-0 last-of-type:border-none dark:border-white/25">
                <div class="mb-2 text-sm uppercase">{s.date}</div>
                {s.link ? (
                  <a href={s.link} target="_blank" rel="noreferrer" class="font-semibold text-primary">
                    {s.institution}
                  </a>
                ) : (
                  <div class="font-semibold">{s.institution}</div>
                )}
                <div class="text-sm font-semibold">{s.title}</div>
                {s.details?.length ? (
                  <ul class="mt-3 list-disc space-y-1 pl-5 text-sm text-muted-foreground">
                    {s.details.map((d) => (
                      <li>{d}</li>
                    ))}
                  </ul>
                ) : null}
              </li>
            ))
          }
        </ul>
      </section>
    </BottomLayout>
  </main>
</BaseLayout>
