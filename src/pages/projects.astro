---
import { PROJECTS, CV_PROJECTS } from '../lib/constants'
import BaseLayout from '../layouts/BaseLayout.astro'
import TopLayout from '../layouts/TopLayout.astro'
import BottomLayout from '../layouts/BottomLayout.astro'
import ProjectDialog from '../components/ProjectDialog.astro'

const getYears = (period: string) => {
  const match = period.match(/(\d{4})\s*-\s*(\d{4}|xxxx)/i)
  if (!match) return { start: 0, end: 0 }
  const start = Number(match[1])
  const end = match[2].toLowerCase() === 'xxxx' ? 9999 : Number(match[2])
  return { start, end }
}

const byRecent = (a: { period: string }, b: { period: string }) => {
  const aYears = getYears(a.period)
  const bYears = getYears(b.period)
  if (aYears.end !== bYears.end) return bYears.end - aYears.end
  return bYears.start - aYears.start
}

const featuredProjects = CV_PROJECTS.filter((project) => project.featured).sort(byRecent)
---

<BaseLayout title={PROJECTS.TITLE} description={PROJECTS.DESCRIPTION}>
  <main class="flex min-h-[80vh] flex-auto flex-col" transition:animate="fade">
    <TopLayout>
      <h2 class="scroll-m-20 border-b pb-2 text-3xl font-semibold tracking-tight first:mt-0">
        {PROJECTS.TITLE}
      </h2>
    </TopLayout>

    <BottomLayout>
      <div class="space-y-8">
        <section class="space-y-4">
          <p class="max-w-3xl text-sm text-muted-foreground">
            Ausgewählte Projekte und Mandate aus den letzten Jahren. Die vollständige Berufserfahrung findet sich unter &nbsp;
            <a href="/work" class="text-primary">Berufserfahrung</a>.
          </p>
          <div class="grid gap-3 md:grid-cols-2">
            {
              featuredProjects.map((project, index) => (
                <article class="rounded-lg border p-4">
                  <p class="mt-1 font-semibold">{project.title}</p>
                  {(project.role || project.sector) && (
                    <p class="mt-1 text-xs font-medium text-muted-foreground">
                      {[project.role, project.sector].filter(Boolean).join(' · ')}
                    </p>
                  )}
                  <p class="mt-1 text-xs text-muted-foreground">Zeitraum: {project.period.replace('xxxx', 'heute')}</p>
                  <p class="mt-1 text-xs text-muted-foreground">{project.stack.join(' · ')}</p>
                  <p class="mt-2 text-sm text-muted-foreground">{project.description}</p>
                  <ProjectDialog
                    dialogId={`cv-${index}`}
                    title={project.title}
                    description={project.description}
                    image={project.image}
                  >
                    {(project.role || project.sector) && (
                      <p class="text-sm"><span class="font-semibold">Rolle:</span> {[project.role, project.sector].filter(Boolean).join(' · ')}</p>
                    )}
                    <p class="text-sm"><span class="font-semibold">Zeitraum:</span> {project.period.replace('xxxx', 'heute')}</p>
                    <p class="text-sm">{project.stack.join(' · ')}</p>
                    <p class="text-sm">{project.details}</p>
                  </ProjectDialog>
                </article>
              ))
            }
          </div>
        </section>
      </div>
    </BottomLayout>
  </main>
</BaseLayout>
